import { useState } from 'react';
import './index.css';
import type { User, Event, EventCategory } from './types';

// ── Storage ──────────────────────────────────────────────────────────────────
function loadUsers(): User[] {
  try { return JSON.parse(localStorage.getItem('ex_users') ?? '[]'); } catch { return []; }
}
function saveUsers(u: User[]) { localStorage.setItem('ex_users', JSON.stringify(u)); }
function loadEvents(): Event[] {
  try { return JSON.parse(localStorage.getItem('ex_events') ?? '[]'); } catch { return []; }
}
function saveEvents(e: Event[]) { localStorage.setItem('ex_events', JSON.stringify(e)); }
const genId = () => Math.random().toString(36).slice(2, 9);

// ── Category config ───────────────────────────────────────────────────────────
const CATEGORIES: { value: EventCategory; label: string; icon: string; color: string; bg: string }[] = [
  { value: 'outdoor-games',   label: 'Outdoor Games',    icon: '🏆', color: '#16a34a', bg: '#dcfce7' },
  { value: 'indoor-games',    label: 'Indoor Games',     icon: '🎮', color: '#7c3aed', bg: '#ede9fe' },
  { value: 'hackathon',       label: 'Hackathon',        icon: '💡', color: '#d97706', bg: '#fef3c7' },
  { value: 'coding-challenge',label: 'Coding Challenge', icon: '💻', color: '#0369a1', bg: '#e0f2fe' },
];

const getCat = (v: EventCategory) => CATEGORIES.find(c => c.value === v)!;

const STATUS_CLASS: Record<Event['status'], string> = {
  upcoming: 'badge-blue',
  ongoing: 'badge-green',
  completed: 'badge-gray',
};

// ── EventForm ─────────────────────────────────────────────────────────────────
function EventForm({ currentUser, existing, onSave, onClose }: {
  currentUser: User; existing?: Event; onSave: (e: Event) => void; onClose: () => void;
}) {
  const [form, setForm] = useState({
    title: existing?.title ?? '',
    description: existing?.description ?? '',
    category: (existing?.category ?? 'outdoor-games') as EventCategory,
    date: existing?.date ?? '',
    time: existing?.time ?? '',
    venue: existing?.venue ?? '',
    maxParticipants: existing?.maxParticipants ?? '',
    status: (existing?.status ?? 'upcoming') as Event['status'],
  });

  const set = (k: string, v: string) => setForm(f => ({ ...f, [k]: v }));

  const handleSubmit = (ev: React.FormEvent) => {
    ev.preventDefault();
    onSave({
      id: existing?.id ?? genId(),
      ...form,
      hostId: existing?.hostId ?? currentUser.id,
      hostName: existing?.hostName ?? currentUser.name,
    });
  };

  return (
    <div className="modal-overlay" onClick={onClose}>
      <div className="modal" onClick={ev => ev.stopPropagation()}>
        <div className="modal-header">
          <h2>{existing ? 'Edit Event' : 'Host New Event'}</h2>
          <button className="icon-btn" onClick={onClose}>✕</button>
        </div>
        <form onSubmit={handleSubmit} className="event-form">
          <div className="form-row">
            <div className="form-group">
              <label>Event Title</label>
              <input value={form.title} onChange={ev => set('title', ev.target.value)} placeholder="e.g. Summer Hackathon 2025" required />
            </div>
            <div className="form-group">
              <label>Category</label>
              <select value={form.category} onChange={ev => set('category', ev.target.value)}>
                {CATEGORIES.map(c => <option key={c.value} value={c.value}>{c.icon} {c.label}</option>)}
              </select>
            </div>
          </div>
          <div className="form-group">
            <label>Description</label>
            <textarea value={form.description} onChange={ev => set('description', ev.target.value)} rows={3} placeholder="Describe the event..." required />
          </div>
          <div className="form-row">
            <div className="form-group">
              <label>Date</label>
              <input type="date" value={form.date} onChange={ev => set('date', ev.target.value)} required />
            </div>
            <div className="form-group">
              <label>Time</label>
              <input type="time" value={form.time} onChange={ev => set('time', ev.target.value)} required />
            </div>
          </div>
          <div className="form-row">
            <div className="form-group">
              <label>Venue</label>
              <input value={form.venue} onChange={ev => set('venue', ev.target.value)} placeholder="e.g. Main Hall" required />
            </div>
            <div className="form-group">
              <label>Max Participants</label>
              <input type="number" min="1" value={form.maxParticipants} onChange={ev => set('maxParticipants', ev.target.value)} placeholder="e.g. 50" required />
            </div>
          </div>
          <div className="form-group">
            <label>Status</label>
            <select value={form.status} onChange={ev => set('status', ev.target.value)}>
              <option value="upcoming">Upcoming</option>
              <option value="ongoing">Ongoing</option>
              <option value="completed">Completed</option>
            </select>
          </div>
          <div className="form-actions">
            <button type="button" className="btn btn-ghost" onClick={onClose}>Cancel</button>
            <button type="submit" className="btn btn-primary">Save Event</button>
          </div>
        </form>
      </div>
    </div>
  );
}

// ── EventCard ─────────────────────────────────────────────────────────────────
function EventCard({ event, currentUser, onEdit, onDelete }: {
  event: Event; currentUser: User; onEdit?: (e: Event) => void; onDelete?: (id: string) => void;
}) {
  const cat = getCat(event.category);
  const canManage = currentUser.role === 'admin' || currentUser.id === event.hostId;

  return (
    <div className="event-card">
      <div className="event-card-top" style={{ background: cat.bg }}>
        <span className="cat-icon">{cat.icon}</span>
        <div className="event-card-top-right">
          <span className={`badge ${STATUS_CLASS[event.status]}`}>{event.status}</span>
          {canManage && (
            <div className="card-actions">
              {onEdit && <button className="icon-btn" onClick={() => onEdit(event)}>✏️</button>}
              {onDelete && <button className="icon-btn danger" onClick={() => onDelete(event.id)}>🗑️</button>}
            </div>
          )}
        </div>
      </div>
      <div className="event-card-body">
        <span className="cat-label" style={{ color: cat.color }}>{cat.label}</span>
        <h3>{event.title}</h3>
        <p className="event-desc">{event.description}</p>
        <div className="event-meta">
          <span>📅 {event.date}</span>
          <span>🕐 {event.time}</span>
          <span>📍 {event.venue}</span>
          <span>👥 {event.maxParticipants} spots</span>
          <span>🎙 {event.hostName}</span>
        </div>
      </div>
    </div>
  );
}

// ── StatsBar ──────────────────────────────────────────────────────────────────
function StatsBar({ events }: { events: Event[] }) {
  const stats = CATEGORIES.map(c => ({
    ...c,
    count: events.filter(e => e.category === c.value).length,
  }));
  const upcoming = events.filter(e => e.status === 'upcoming').length;
  const ongoing  = events.filter(e => e.status === 'ongoing').length;

  return (
    <div className="stats-bar">
      {stats.map(s => (
        <div className="stat-card" key={s.value} style={{ borderTop: `3px solid ${s.color}` }}>
          <span className="stat-icon">{s.icon}</span>
          <div>
            <p className="stat-count">{s.count}</p>
            <p className="stat-label">{s.label}</p>
          </div>
        </div>
      ))}
      <div className="stat-card" style={{ borderTop: '3px solid #3b82f6' }}>
        <span className="stat-icon">🗓</span>
        <div>
          <p className="stat-count">{upcoming}</p>
          <p className="stat-label">Upcoming</p>
        </div>
      </div>
      <div className="stat-card" style={{ borderTop: '3px solid #22c55e' }}>
        <span className="stat-icon">🔴</span>
        <div>
          <p className="stat-count">{ongoing}</p>
          <p className="stat-label">Live Now</p>
        </div>
      </div>
    </div>
  );
}

// ── EventsView (shared grid with filter) ─────────────────────────────────────
function EventsView({ events, currentUser, onEdit, onDelete, showCreate }: {
  events: Event[]; currentUser: User;
  onEdit: (e: Event) => void; onDelete: (id: string) => void;
  showCreate: () => void;
}) {
  const [filter, setFilter] = useState<EventCategory | 'all'>('all');
  const [statusFilter, setStatusFilter] = useState<Event['status'] | 'all'>('all');

  const filtered = events
    .filter(e => filter === 'all' || e.category === filter)
    .filter(e => statusFilter === 'all' || e.status === statusFilter);

  return (
    <div>
      <div className="filter-bar">
        <div className="filter-group">
          <button className={`filter-btn ${filter === 'all' ? 'active' : ''}`} onClick={() => setFilter('all')}>All</button>
          {CATEGORIES.map(c => (
            <button key={c.value} className={`filter-btn ${filter === c.value ? 'active' : ''}`} style={filter === c.value ? { background: c.bg, color: c.color, borderColor: c.color } : {}} onClick={() => setFilter(c.value)}>
              {c.icon} {c.label}
            </button>
          ))}
        </div>
        <div className="filter-group">
          {(['all', 'upcoming', 'ongoing', 'completed'] as const).map(s => (
            <button key={s} className={`filter-btn ${statusFilter === s ? 'active' : ''}`} onClick={() => setStatusFilter(s)}>
              {s === 'all' ? 'All Status' : s.charAt(0).toUpperCase() + s.slice(1)}
            </button>
          ))}
        </div>
        {(currentUser.role === 'admin' || currentUser.canHostEvent) && (
          <button className="btn btn-primary" onClick={showCreate}>+ Host Event</button>
        )}
      </div>
      {filtered.length === 0
        ? <div className="empty-state"><p>🎯</p><p>No events found for this filter.</p></div>
        : <div className="events-grid">{filtered.map(e => <EventCard key={e.id} event={e} currentUser={currentUser} onEdit={onEdit} onDelete={onDelete} />)}</div>
      }
    </div>
  );
}

// ── AdminPanel ────────────────────────────────────────────────────────────────
function AdminPanel({ currentUser, users, events, onToggleHost, onSaveEvent, onDeleteEvent }: {
  currentUser: User; users: User[]; events: Event[];
  onToggleHost: (id: string) => void; onSaveEvent: (e: Event) => void; onDeleteEvent: (id: string) => void;
}) {
  const [tab, setTab] = useState<'dashboard' | 'events' | 'users'>('dashboard');
  const [showForm, setShowForm] = useState(false);
  const [editing, setEditing] = useState<Event | undefined>();

  const openEdit = (e: Event) => { setEditing(e); setShowForm(true); };
  const handleSave = (e: Event) => { onSaveEvent(e); setShowForm(false); };
  const employees = users.filter(u => u.role === 'employee');

  return (
    <div className="panel">
      <div className="panel-tabs">
        <button className={`tab ${tab === 'dashboard' ? 'active' : ''}`} onClick={() => setTab('dashboard')}>📊 Dashboard</button>
        <button className={`tab ${tab === 'events' ? 'active' : ''}`} onClick={() => setTab('events')}>🗓 Events ({events.length})</button>
        <button className={`tab ${tab === 'users' ? 'active' : ''}`} onClick={() => setTab('users')}>👥 Users ({employees.length})</button>
      </div>

      {tab === 'dashboard' && (
        <div>
          <div className="welcome-banner">
            <div>
              <h2>Welcome back, {currentUser.name} 👋</h2>
              <p>Manage all organization events and control employee hosting permissions.</p>
            </div>
          </div>
          <StatsBar events={events} />
          {events.length > 0 && (
            <>
              <div className="section-header" style={{ marginTop: '2rem' }}>
                <h2>Recent Events</h2>
                <button className="btn btn-ghost btn-sm" onClick={() => setTab('events')}>View All →</button>
              </div>
              <div className="events-grid">
                {events.slice(-3).reverse().map(e => <EventCard key={e.id} event={e} currentUser={currentUser} onEdit={openEdit} onDelete={onDeleteEvent} />)}
              </div>
            </>
          )}
          {events.length === 0 && <div className="empty-state"><p>🎯</p><p>No events yet. Go to Events tab to create one.</p></div>}
        </div>
      )}

      {tab === 'events' && (
        <EventsView
          events={events} currentUser={currentUser}
          onEdit={openEdit} onDelete={onDeleteEvent}
          showCreate={() => { setEditing(undefined); setShowForm(true); }}
        />
      )}

      {tab === 'users' && (
        <div>
          <div className="section-header"><h2>Employee Access Control</h2></div>
          {employees.length === 0
            ? <div className="empty-state"><p>👥</p><p>No employees registered yet.</p></div>
            : (
              <div className="user-table">
                <div className="user-table-head">
                  <span>Name</span><span>Email</span><span>Host Access</span><span>Action</span>
                </div>
                {employees.map(u => (
                  <div key={u.id} className="user-row">
                    <span className="user-name-cell"><span className="avatar">{u.name[0]}</span>{u.name}</span>
                    <span className="muted">{u.email}</span>
                    <span><span className={`badge ${u.canHostEvent ? 'badge-green' : 'badge-gray'}`}>{u.canHostEvent ? 'Granted' : 'Restricted'}</span></span>
                    <span>
                      <button className={`btn btn-sm ${u.canHostEvent ? 'btn-danger' : 'btn-success'}`} onClick={() => onToggleHost(u.id)}>
                        {u.canHostEvent ? 'Revoke' : 'Grant'} Access
                      </button>
                    </span>
                  </div>
                ))}
              </div>
            )
          }
        </div>
      )}

      {showForm && <EventForm currentUser={currentUser} existing={editing} onSave={handleSave} onClose={() => setShowForm(false)} />}
    </div>
  );
}

// ── EmployeeDashboard ─────────────────────────────────────────────────────────
function EmployeeDashboard({ currentUser, events, onSaveEvent, onDeleteEvent }: {
  currentUser: User; events: Event[]; onSaveEvent: (e: Event) => void; onDeleteEvent: (id: string) => void;
}) {
  const [tab, setTab] = useState<'dashboard' | 'all' | 'mine'>('dashboard');
  const [showForm, setShowForm] = useState(false);
  const [editing, setEditing] = useState<Event | undefined>();

  const openEdit = (e: Event) => { setEditing(e); setShowForm(true); };
  const handleSave = (e: Event) => { onSaveEvent(e); setShowForm(false); };
  const myEvents = events.filter(e => e.hostId === currentUser.id);

  return (
    <div className="panel">
      <div className="panel-tabs">
        <button className={`tab ${tab === 'dashboard' ? 'active' : ''}`} onClick={() => setTab('dashboard')}>📊 Dashboard</button>
        <button className={`tab ${tab === 'all' ? 'active' : ''}`} onClick={() => setTab('all')}>🗓 All Events ({events.length})</button>
        {currentUser.canHostEvent && (
          <button className={`tab ${tab === 'mine' ? 'active' : ''}`} onClick={() => setTab('mine')}>🎙 My Events ({myEvents.length})</button>
        )}
      </div>

      {tab === 'dashboard' && (
        <div>
          <div className="welcome-banner">
            <div>
              <h2>Hey, {currentUser.name} 👋</h2>
              <p>{currentUser.canHostEvent ? 'You can host events. Go to All Events to explore or host a new one.' : 'Explore all organization events below. Contact HR to get hosting access.'}</p>
            </div>
            {!currentUser.canHostEvent && (
              <div className="notice-inline">🔒 Host access not granted</div>
            )}
          </div>
          <StatsBar events={events} />
          {events.length > 0 && (
            <>
              <div className="section-header" style={{ marginTop: '2rem' }}>
                <h2>Latest Events</h2>
                <button className="btn btn-ghost btn-sm" onClick={() => setTab('all')}>View All →</button>
              </div>
              <div className="events-grid">
                {events.slice(-3).reverse().map(e => <EventCard key={e.id} event={e} currentUser={currentUser} onEdit={openEdit} onDelete={onDeleteEvent} />)}
              </div>
            </>
          )}
          {events.length === 0 && <div className="empty-state"><p>🎯</p><p>No events scheduled yet.</p></div>}
        </div>
      )}

      {tab === 'all' && (
        <EventsView
          events={events} currentUser={currentUser}
          onEdit={openEdit} onDelete={onDeleteEvent}
          showCreate={() => { setEditing(undefined); setShowForm(true); }}
        />
      )}

      {tab === 'mine' && (
        <div>
          <div className="section-header">
            <h2>My Hosted Events</h2>
            <button className="btn btn-primary" onClick={() => { setEditing(undefined); setShowForm(true); }}>+ Host Event</button>
          </div>
          {myEvents.length === 0
            ? <div className="empty-state"><p>🎙</p><p>You haven't hosted any events yet.</p></div>
            : <div className="events-grid">{myEvents.map(e => <EventCard key={e.id} event={e} currentUser={currentUser} onEdit={openEdit} onDelete={onDeleteEvent} />)}</div>
          }
        </div>
      )}

      {showForm && <EventForm currentUser={currentUser} existing={editing} onSave={handleSave} onClose={() => setShowForm(false)} />}
    </div>
  );
}

// ── Auth ──────────────────────────────────────────────────────────────────────
function LoginPage({ users, onLogin, onGoSignup }: { users: User[]; onLogin: (u: User) => void; onGoSignup: () => void }) {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState('');

  const handleSubmit = (ev: React.FormEvent) => {
    ev.preventDefault();
    const user = users.find(u => u.email === email && u.password === password);
    if (user) onLogin(user);
    else setError('Invalid email or password.');
  };

  return (
    <div className="login-wrapper">
      <div className="login-card">
        <div className="login-logo">🚀</div>
        <h1>ElevateX</h1>
        <p className="login-sub">Organization Event Management</p>
        <form onSubmit={handleSubmit}>
          <div className="form-group">
            <label>Email</label>
            <input type="email" value={email} onChange={ev => setEmail(ev.target.value)} placeholder="you@org.com" required />
          </div>
          <div className="form-group">
            <label>Password</label>
            <input type="password" value={password} onChange={ev => setPassword(ev.target.value)} placeholder="••••••••" required />
          </div>
          {error && <p className="error-msg">{error}</p>}
          <button type="submit" className="btn btn-primary btn-full">Sign In</button>
        </form>
        <p className="auth-switch">Don't have an account? <button className="link-btn" onClick={onGoSignup}>Sign Up</button></p>
      </div>
    </div>
  );
}

function SignupPage({ users, onSignup, onGoLogin }: { users: User[]; onSignup: (u: User) => void; onGoLogin: () => void }) {
  const [form, setForm] = useState({ name: '', email: '', password: '', confirm: '' });
  const [error, setError] = useState('');
  const set = (k: string, v: string) => setForm(f => ({ ...f, [k]: v }));

  const handleSubmit = (ev: React.FormEvent) => {
    ev.preventDefault();
    if (form.password !== form.confirm) { setError('Passwords do not match.'); return; }
    if (form.password.length < 6) { setError('Password must be at least 6 characters.'); return; }
    if (users.find(u => u.email === form.email)) { setError('Email already registered.'); return; }
    onSignup({ id: genId(), name: form.name, email: form.email, password: form.password, role: 'employee', canHostEvent: false });
  };

  return (
    <div className="login-wrapper">
      <div className="login-card">
        <div className="login-logo">🚀</div>
        <h1>ElevateX</h1>
        <p className="login-sub">Create your account</p>
        <form onSubmit={handleSubmit}>
          <div className="form-group">
            <label>Full Name</label>
            <input value={form.name} onChange={ev => set('name', ev.target.value)} placeholder="John Doe" required />
          </div>
          <div className="form-group">
            <label>Email</label>
            <input type="email" value={form.email} onChange={ev => set('email', ev.target.value)} placeholder="you@org.com" required />
          </div>
          <div className="form-group">
            <label>Password</label>
            <input type="password" value={form.password} onChange={ev => set('password', ev.target.value)} placeholder="Min. 6 characters" required />
          </div>
          <div className="form-group">
            <label>Confirm Password</label>
            <input type="password" value={form.confirm} onChange={ev => set('confirm', ev.target.value)} placeholder="Re-enter password" required />
          </div>
          {error && <p className="error-msg">{error}</p>}
          <button type="submit" className="btn btn-primary btn-full">Create Account</button>
        </form>
        <p className="auth-switch">Already have an account? <button className="link-btn" onClick={onGoLogin}>Sign In</button></p>
      </div>
    </div>
  );
}

// ── App ───────────────────────────────────────────────────────────────────────
export default function App() {
  const [users, setUsers] = useState<User[]>(loadUsers);
  const [events, setEvents] = useState<Event[]>(loadEvents);
  const [currentUser, setCurrentUser] = useState<User | null>(null);
  const [page, setPage] = useState<'login' | 'signup'>('login');

  const handleSignup = (u: User) => {
    const updated = [...users, u];
    setUsers(updated); saveUsers(updated); setCurrentUser(u);
  };

  const toggleHostAccess = (userId: string) => {
    const updated = users.map(u => u.id === userId ? { ...u, canHostEvent: !u.canHostEvent } : u);
    setUsers(updated); saveUsers(updated);
  };

  const saveEvent = (event: Event) => {
    const updated = events.some(e => e.id === event.id)
      ? events.map(e => e.id === event.id ? event : e)
      : [...events, event];
    setEvents(updated); saveEvents(updated);
  };

  const deleteEvent = (id: string) => {
    const updated = events.filter(e => e.id !== id);
    setEvents(updated); saveEvents(updated);
  };

  const syncedUser = currentUser ? (users.find(u => u.id === currentUser.id) ?? currentUser) : null;

  if (!syncedUser) {
    return page === 'login'
      ? <LoginPage users={users} onLogin={u => setCurrentUser(u)} onGoSignup={() => setPage('signup')} />
      : <SignupPage users={users} onSignup={handleSignup} onGoLogin={() => setPage('login')} />;
  }

  return (
    <div className="app">
      <header className="topbar">
        <div className="topbar-left">
          <span className="logo">🚀 ElevateX</span>
          {syncedUser.role === 'admin' && <span className="badge badge-purple">HR Admin</span>}
        </div>
        <div className="topbar-right">
          <div className="avatar-sm">{syncedUser.name[0]}</div>
          <span className="user-name">{syncedUser.name}</span>
          <button className="btn btn-ghost btn-sm" onClick={() => setCurrentUser(null)}>Logout</button>
        </div>
      </header>
      <main className="main-content">
        {syncedUser.role === 'admin'
          ? <AdminPanel currentUser={syncedUser} users={users} events={events} onToggleHost={toggleHostAccess} onSaveEvent={saveEvent} onDeleteEvent={deleteEvent} />
          : <EmployeeDashboard currentUser={syncedUser} events={events} onSaveEvent={saveEvent} onDeleteEvent={deleteEvent} />
        }
      </main>
    </div>
  );
}
