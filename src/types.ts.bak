export type Role = 'admin' | 'employee';

export type InitiativeStatus = 'active' | 'closed';
export type SubmissionStatus = 'not-started' | 'submitted' | 'approved' | 'rejected';
export type ValidationType = 'manual';

export interface User {
  id: string;
  name: string;
  email: string;
  password: string;
  role: Role;
  totalPoints: number;
  createdAt: string;
}

export interface Initiative {
  id: string;
  title: string;
  description: string;
  deadline: string;
  rewardPoints: number;
  validationType: ValidationType;
  status: InitiativeStatus;
  createdBy: string;
  createdAt: string;
}

export interface Submission {
  id: string;
  initiativeId: string;
  initiativeTitle: string;
  userId: string;
  userName: string;
  link: string;
  note: string;
  status: SubmissionStatus;
  submittedAt: string;
  reviewedAt: string | null;
  reviewNote: string;
}

export interface PointsTransaction {
  id: string;
  userId: string;
  points: number;
  reason: string;
  initiativeTitle: string;
  earnedAt: string;
}
